set(test_root "@CMAKE_CURRENT_BINARY_DIR@/package_consumer_test")
set(install_root "${test_root}/install")
set(consumer_build "${test_root}/consumer")
file(REMOVE_RECURSE "${test_root}")

set(build_config "@CMAKE_BUILD_TYPE@")
if(build_config STREQUAL "")
    set(build_config Release)
endif()

set(install_command
    "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
    --prefix "${install_root}"
    --config "${build_config}")
execute_process(
    COMMAND ${install_command}
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "mollm package install failed: ${result}")
endif()

set(consumer_configure
    "@CMAKE_COMMAND@"
    -S "@CMAKE_CURRENT_SOURCE_DIR@/tests/package_consumer"
    -B "${consumer_build}"
    -G "@CMAKE_GENERATOR@"
    "-DCMAKE_PREFIX_PATH=${install_root}"
    "-DCMAKE_BUILD_TYPE=${build_config}")
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
    list(APPEND consumer_configure -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
execute_process(
    COMMAND ${consumer_configure}
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "package consumer configure failed: ${result}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "${consumer_build}" --config "${build_config}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "package consumer build failed: ${result}")
endif()

set(consumer_exe "")
foreach(candidate IN ITEMS
        "${consumer_build}/mollm_package_consumer.exe"
        "${consumer_build}/${build_config}/mollm_package_consumer.exe"
        "${consumer_build}/${build_config}/mollm_package_consumer"
        "${consumer_build}/mollm_package_consumer")
    if(consumer_exe STREQUAL "" AND EXISTS "${candidate}")
        set(consumer_exe "${candidate}")
    endif()
endforeach()
if(consumer_exe STREQUAL "")
    message(FATAL_ERROR "package consumer executable not found")
endif()

execute_process(
    COMMAND "${consumer_exe}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "package consumer failed: ${result}")
endif()
